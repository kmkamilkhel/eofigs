    affiliation: "Institute of Forest Sciences, University of Swat, Khyber Pakhtunkhwa, Pakistan"
repository-code: "https://github.com/kmkamilkhel/eofigs"
url: "https://kmkamilkhel.github.io/eofigs/"
license: MIT
keywords:
  - remote sensing
  - earth observation
  - geospatial
  - cartography
  - scientific figures
  - python
